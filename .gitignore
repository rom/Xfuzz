# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Web console build artifacts.
#
# The bundle is generated and not in the repository: a compiled bundle in git
# is a diff nobody can review and a merge nobody can resolve. `make
# build-console` produces it, and the binary that embeds it is built from it.
/web/node_modules/
/web/dist/
/internal/console/dist/

# Local campaign state (never commit corpora, findings, or captures)
/var/
/.xfuzz/
*.xfuzzdb
corpus/
findings/
captures/

# Editor / OS
.DS_Store
.idea/
.vscode/
bench/current.txt
